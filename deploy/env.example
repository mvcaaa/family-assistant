# Скопируй в /etc/family-assistant.env и выставь права: chmod 600
# Реальные значения сюда не записывай.

TELEGRAM_BOT_TOKEN=
# bot — будит Grok Bot и тратит недельную подписку
# api — ответ через api.x.ai, отдельный счёт
# echo — повторяет текст, чтобы проверить Telegram
ASSISTANT_BACKEND=bot
# Поля routine после сохранения вебхука. Ключ как пароль.
GROK_BOT_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/ЗАМЕНИ
GROK_BOT_WEBHOOK_KEY=
# Адрес, по которому Grok Bot достучится до этого шлюза. Для дома нужен https.
GATEWAY_PUBLIC_URL=https://family.example
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
PASS_TTL=900
# Нужны только для ASSISTANT_BACKEND=api
XAI_API_KEY=
XAI_MODEL=grok-4.7
ASSISTANT_NAME=Марфа
# Номера в международном виде, без плюса, через запятую.
ALLOWED_PHONES=358401112233,358404445566
# Этот номер подтверждает покупки, письма, удаления и правку памяти.
OWNER_PHONE=358401112233
DATA_DIR=/var/lib/family-assistant
ENABLE_WEB_SEARCH=1
# 1 — на голосовое отвечать голосом и текстом. 0 — только текст.
VOICE=1
TTS_VOICE=ara
TTS_LANGUAGE=ru
STT_LANGUAGE=ru
APPROVAL_TTL=600
REVIEW_DAYS=7
